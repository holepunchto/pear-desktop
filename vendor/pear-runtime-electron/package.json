{
  "name": "pear-runtime-electron",
  "version": "0.1.0",
  "description": "Reusable Electron + Pear worker bridge utilities",
  "type": "module",
  "main": "./src/index.js",
  "scripts": {
    "test": "brittle-node test/*.test.js",
    "lint": "prettier --check . && lunte",
    "format": "prettier --write ."
  },
  "files": [
    "src/",
    "README.md"
  ],
  "exports": {
    ".": {
      "import": "./src/index.js"
    },
    "./binary": {
      "import": "./src/binary.js"
    },
    "./channels": {
      "import": "./src/channels.js"
    },
    "./main": {
      "import": "./src/main.js"
    },
    "./renderer": {
      "import": "./src/renderer.js"
    },
    "./runtime": {
      "import": "./src/runtime.js"
    },
    "./preload": {
      "import": "./src/preload.js",
      "require": "./src/preload.cjs"
    }
  },
  "imports": {
    "events": {
      "bare": "bare-events",
      "default": "events"
    }
  },
  "keywords": [
    "electron",
    "pear",
    "ipc",
    "hrpc"
  ],
  "license": "MIT",
  "prettier": "prettier-config-holepunch",
  "dependencies": {
    "corestore": "^7.9.1",
    "hyperswarm": "^4.17.0",
    "pear-runtime": "^1.0.1",
    "which-runtime": "^1.3.2"
  },
  "devDependencies": {
    "bare-events": "^2.8.2",
    "brittle": "^3.19.1",
    "lunte": "^1.6.0",
    "prettier": "^3.8.1",
    "prettier-config-holepunch": "^2.0.0"
  }
}
