{
  "name": "pear-desktop",
  "version": "3.0.0",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "lint": "prettier --check . && lunte",
    "format": "prettier --write .",
    "start": "npm run build && electron .",
    "dev": "concurrently -k \"vite --port 5173 --strictPort\" \"wait-on tcp:5173 && PEAR_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build": "vite build",
    "test": "echo 'missing'"
  },
  "build": {
    "appId": "to.holepunch.PearUi",
    "productName": "Pear"
  },
  "dependencies": {
    "pear-container": "^0.1.0",
    "pear-runtime": "^0.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.1.4",
    "brittle": "^3.19.1",
    "concurrently": "^9.2.1",
    "electron": "^40.2.1",
    "esbuild": "^0.27.3",
    "prettier": "^3.8.1",
    "prettier-config-holepunch": "^2.0.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "vite": "^7.3.1",
    "wait-on": "^9.0.3"
  },
  "license": "Apache-2.0",
  "description": "> The Pear Runtime Pear Desktop Application",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/holepunchto/pear-desktop.git"
  },
  "keywords": [],
  "author": "",
  "bugs": {
    "url": "https://github.com/holepunchto/pear-desktop/issues"
  },
  "homepage": "https://github.com/holepunchto/pear-desktop#readme"
}
