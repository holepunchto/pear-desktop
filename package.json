{
  "name": "pear-desktop",
  "productName": "Pear Desktop",
  "version": "3.0.0",
  "upgrade": "pear://epw3ys1gxkpotwh4ngxmqac8ywimfhn16kmz6szbd9cihtockrhy",
  "type": "module",
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "lint": "prettier --check . && lunte",
    "format": "prettier --write .",
    "start": "npm run build && electron-forge start -- --no-updates",
    "dev": "concurrently -k \"vite --port 5173 --strictPort\" \"wait-on tcp:5173 && PEAR_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build": "vite build",
    "make": "npm run build && electron-forge make",
    "package": "npm run build && electron-forge package",
    "stage": "npm run make && APP_DIR=$(ls -d out/pear-desktop-darwin-* | head -n 1) && cp pear.json \"$APP_DIR\" && (cd \"$APP_DIR\" && pear stage pear://$(node -p \"require('./pear.json').key\"))",
    "test": "echo 'missing'"
  },
  "dependencies": {
    "pear-runtime": "^0.4.2"
  },
  "devDependencies": {
    "@base-ui/react": "^1.2.0",
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/maker-zip": "^7.11.1",
    "@tailwindcss/vite": "^4.2.1",
    "@vitejs/plugin-react": "^5.1.4",
    "brittle": "^3.19.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^9.2.1",
    "electron": "^40.6.0",
    "esbuild": "^0.27.3",
    "lucide-react": "^0.575.0",
    "lunte": "^1.6.0",
    "prettier": "^3.8.1",
    "prettier-config-holepunch": "^2.0.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.4.0",
    "vite": "^7.3.1",
    "wait-on": "^9.0.4"
  },
  "license": "Apache-2.0",
  "description": "> The Pear Runtime Pear Desktop Application",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/holepunchto/pear-desktop.git"
  },
  "keywords": [],
  "author": "",
  "bugs": {
    "url": "https://github.com/holepunchto/pear-desktop/issues"
  },
  "homepage": "https://github.com/holepunchto/pear-desktop#readme"
}
